# Copy to .env and fill in locally. Never commit .env.
# IRSA public data needs no keys.

# Where the backend keeps downloaded cutouts (default: ./data/cache)
SPHEREX_CACHE_DIR=./data/cache

# Comma-separated origins allowed to call the API (the GitHub Pages URL in production)
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Port for local runs
PORT=8000
